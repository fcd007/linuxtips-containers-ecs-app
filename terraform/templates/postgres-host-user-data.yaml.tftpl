#cloud-config
bootcmd:
  - mkdir -p /etc/systemd/system/ecs.service.d
  - |
    cat > /etc/systemd/system/ecs.service.d/postgres-volume.conf <<'EOF'
    [Unit]
    After=cloud-final.service
    Requires=cloud-final.service
    RequiresMountsFor=/mnt/buggytrip-postgres
    EOF
  - systemctl daemon-reload
runcmd:
  - |
    set -eu
    mkdir -p /etc/ecs
    printf 'ECS_CLUSTER=%s\n' '${ecs_cluster_name}' > /etc/ecs/ecs.config
    printf 'ECS_ENABLE_CONTAINER_METADATA=true\n' >> /etc/ecs/ecs.config
    volume_device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_id}"
    attempt=0
    until [ -b "$volume_device" ] || [ "$attempt" -ge 120 ]; do
      attempt=$((attempt + 1))
      sleep 5
    done
    if [ ! -b "$volume_device" ]; then
      echo "Persistent PostgreSQL EBS volume did not appear: $volume_device" >&2
      exit 1
    fi
    if ! blkid "$volume_device" >/dev/null 2>&1; then
      mkfs.ext4 -F "$volume_device"
    fi
    volume_uuid="$(blkid -s UUID -o value "$volume_device")"
    mkdir -p /mnt/buggytrip-postgres
    grep -q "UUID=$volume_uuid " /etc/fstab || \
      printf 'UUID=%s /mnt/buggytrip-postgres ext4 defaults,nofail 0 2\n' "$volume_uuid" >> /etc/fstab
    mount /mnt/buggytrip-postgres
    chown 999:999 /mnt/buggytrip-postgres
